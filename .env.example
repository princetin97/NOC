# Copy to .env and adjust before running `docker compose up -d`.
POSTGRES_USER=monitor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=device_monitor
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8080
POLL_INTERVAL_SECONDS=60
POLL_WORKER_CONCURRENCY=16
POLL_QUEUE_BUFFER_MULTIPLIER=2
POLL_FAST_INTERVAL_SECONDS=12
POLL_FAST_BATCH_SIZE=60
SNMP_TIMEOUT_MS=2000
SNMP_RETRIES=0
DOWN_FAIL_STREAK_THRESHOLD=2
DISCOVERY_INTERVAL_SECONDS=43200
DISCOVERY_WORKER_CONCURRENCY=2
SERVICE_WORKER_CONCURRENCY=6
SERVICE_CHECK_INTERVAL_SECONDS=20
SERVICE_CHECK_FAST_INTERVAL_SECONDS=10
VCENTER_SYNC_INTERVAL_SECONDS=120
GEMINI_API_KEY=
